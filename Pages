import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion } from 'framer-motion';
import { Save, Building, Zap, Droplets, Users, Trash, Fuel } from 'lucide-react';
import { useAppContext } from '../context/AppContext.jsx';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';

function ESGDataInputPage() {
  const navigate = useNavigate();
  const { companyData, saveCompanyData } = useAppContext();
  const [isSaved, setIsSaved] = useState(false);

  const [formData, setFormData] = useState(companyData || {
    companyName: '',
    industry: '',
    electricity: '',
    fuel: '',
    water: '',
    employees: '',
    waste: ''
  });

  const handleChange = (field, value) => {
    setFormData(prev => ({ ...prev, [field]: value }));
    setIsSaved(false);
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    saveCompanyData(formData);
    setIsSaved(true);
    setTimeout(() => {
      navigate('/generate-report');
    }, 1500);
  };

  return (
    <div className="max-w-3xl mx-auto">
      <div className="mb-8">
        <h1 className="text-brand-blue mb-2">ESG Data Input</h1>
        <p className="text-muted-foreground">Enter your company's operational metrics to calculate your ESG score and carbon footprint.</p>
      </div>

      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="card-panel"
      >
        <form onSubmit={handleSubmit} className="space-y-8">
          {/* Company Info */}
          <div className="space-y-4">
            <h3 className="text-lg font-semibold flex items-center gap-2 border-b pb-2">
              <Building className="w-5 h-5 text-brand-blue" />
              Company Information
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="space-y-2">
                <Label htmlFor="companyName">Company Name</Label>
                <Input
                  id="companyName"
                  required
                  value={formData.companyName}
                  onChange={(e) => handleChange('companyName', e.target.value)}
                  placeholder="e.g. Acme Corp"
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="industry">Industry</Label>
                <Select 
                  required 
                  value={formData.industry} 
                  onValueChange={(val) => handleChange('industry', val)}
                >
                  <SelectTrigger>
                    <SelectValue placeholder="Select industry" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="Technology">Technology</SelectItem>
                    <SelectItem value="Manufacturing">Manufacturing</SelectItem>
                    <SelectItem value="Energy">Energy</SelectItem>
                    <SelectItem value="Retail">Retail</SelectItem>
                    <SelectItem value="Finance">Finance</SelectItem>
                    <SelectItem value="Other">Other</SelectItem>
                  </SelectContent>
                </Select>
              </div>
            </div>
          </div>

          {/* Environmental Metrics */}
          <div className="space-y-4">
            <h3 className="text-lg font-semibold flex items-center gap-2 border-b pb-2">
              <Zap className="w-5 h-5 text-brand-blue" />
              Environmental Metrics
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="space-y-2">
                <Label htmlFor="electricity">Electricity Usage (kWh/month)</Label>
                <div className="relative">
                  <Zap className="absolute left-3 top-3 w-4 h-4 text-muted-foreground" />
                  <Input
                    id="electricity"
                    type="number"
                    required
                    min="0"
                    className="pl-9"
                    value={formData.electricity}
                    onChange={(e) => handleChange('electricity', e.target.value)}
                    placeholder="0"
                  />
                </div>
              </div>
              <div className="space-y-2">
                <Label htmlFor="fuel">Fuel Usage (liters/month)</Label>
                <div className="relative">
                  <Fuel className="absolute left-3 top-3 w-4 h-4 text-muted-foreground" />
                  <Input
                    id="fuel"
                    type="number"
                    required
                    min="0"
                    className="pl-9"
                    value={formData.fuel}
                    onChange={(e) => handleChange('fuel', e.target.value)}
                    placeholder="0"
                  />
                </div>
              </div>
              <div className="space-y-2">
                <Label htmlFor="water">Water Usage (cubic meters/month)</Label>
                <div className="relative">
                  <Droplets className="absolute left-3 top-3 w-4 h-4 text-muted-foreground" />
                  <Input
                    id="water"
                    type="number"
                    required
                    min="0"
                    className="pl-9"
                    value={formData.water}
                    onChange={(e) => handleChange('water', e.target.value)}
                    placeholder="0"
                  />
                </div>
              </div>
              <div className="space-y-2">
                <Label htmlFor="waste">Waste Produced (kg/month)</Label>
                <div className="relative">
                  <Trash className="absolute left-3 top-3 w-4 h-4 text-muted-foreground" />
                  <Input
                    id="waste"
                    type="number"
                    required
                    min="0"
                    className="pl-9"
                    value={formData.waste}
                    onChange={(e) => handleChange('waste', e.target.value)}
                    placeholder="0"
                  />
                </div>
              </div>
            </div>
          </div>

          {/* Social Metrics */}
          <div className="space-y-4">
            <h3 className="text-lg font-semibold flex items-center gap-2 border-b pb-2">
              <Users className="w-5 h-5 text-brand-blue" />
              Social Metrics
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="space-y-2">
                <Label htmlFor="employees">Number of Employees</Label>
                <div className="relative">
                  <Users className="absolute left-3 top-3 w-4 h-4 text-muted-foreground" />
                  <Input
                    id="employees"
                    type="number"
                    required
                    min="1"
                    className="pl-9"
                    value={formData.employees}
                    onChange={(e) => handleChange('employees', e.target.value)}
                    placeholder="0"
                  />
                </div>
              </div>
            </div>
          </div>

          <div className="pt-4 flex items-center justify-between">
            {isSaved ? (
              <p className="text-[#2ecc71] font-medium flex items-center gap-2">
                <Save className="w-4 h-4" /> Data saved successfully! Redirecting...
              </p>
            ) : (
              <p className="text-sm text-muted-foreground">All fields are required.</p>
            )}
            <Button 
              type="submit" 
              className="bg-brand-blue hover:bg-brand-blue/90 min-w-[140px]"
              disabled={isSaved}
            >
              {isSaved ? 'Saved' : 'Save Data'}
            </Button>
          </div>
        </form>
      </motion.div>
    </div>
  );
}

export default ESGDataInputPage;

import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion } from 'framer-motion';
import { FileText, AlertCircle, CheckCircle2, Loader2 } from 'lucide-react';
import { useAppContext } from '../context/AppContext.jsx';
import { Button } from '@/components/ui/button';

function GenerateReportPage() {
  const navigate = useNavigate();
  const { companyData, saveReportResults } = useAppContext();
  const [isGenerating, setIsGenerating] = useState(false);

  useEffect(() => {
    if (!companyData) {
      navigate('/data-input');
    }
  }, [companyData, navigate]);

  const handleGenerate = () => {
    setIsGenerating(true);

    setTimeout(() => {
      const elec = parseFloat(companyData.electricity) || 0;
      const fuel = parseFloat(companyData.fuel) || 0;
      const water = parseFloat(companyData.water) || 0;
      const waste = parseFloat(companyData.waste) || 0;
      const emp = parseInt(companyData.employees) || 0;

      // Calculate Score
      let score = 100;
      if (elec > 500) score -= 15;
      if (fuel > 300) score -= 15;
      if (water > 500) score -= 10;
      if (waste > 200) score -= 10;
      if (emp > 50) score += 5;
      
      score = Math.max(0, Math.min(100, score));

      // Calculate Emissions
      const emissions = (elec * 0.5) + (fuel * 0.7);

      // Determine Risk
      let risk = 'Low Risk';
      if (score < 50) risk = 'High Risk';
      else if (score <= 75) risk = 'Medium Risk';

      // Generate Suggestions
      const suggestions = [];
      if (elec > 500) suggestions.push('Transition to renewable energy sources to reduce high electricity footprint.');
      if (fuel > 300) suggestions.push('Consider upgrading fleet to electric vehicles to lower fuel consumption.');
      if (water > 500) suggestions.push('Implement water recycling and conservation systems in facilities.');
      if (waste > 200) suggestions.push('Adopt circular economy practices to minimize industrial waste.');
      if (emp <= 50) suggestions.push('Develop employee engagement programs to boost social governance scores.');
      
      if (suggestions.length === 0) {
        suggestions.push('Maintain current excellent sustainability practices.');
        suggestions.push('Consider setting net-zero targets for the next decade.');
      }

      saveReportResults({
        esgScore: score,
        carbonEmission: emissions,
        complianceRisk: risk,
        suggestions: suggestions.slice(0, 4) // Max 4 suggestions
      });

      navigate('/results');
    }, 2000);
  };

  if (!companyData) return null;

  return (
    <div className="max-w-3xl mx-auto">
      <div className="mb-8 text-center">
        <div className="w-16 h-16 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <FileText className="w-8 h-8 text-brand-blue" />
        </div>
        <h1 className="text-brand-blue mb-2">Generate Compliance Report</h1>
        <p className="text-muted-foreground">Review your data before generating the final ESG analysis.</p>
      </div>

      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="card-panel mb-8"
      >
        <div className="flex items-center justify-between border-b pb-4 mb-4">
          <h3 className="text-lg font-semibold">Data Summary</h3>
          <span className="px-3 py-1 bg-[#2ecc71]/10 text-[#2ecc71] rounded-full text-sm font-medium flex items-center gap-1">
            <CheckCircle2 className="w-4 h-4" /> Ready
          </span>
        </div>

        <div className="grid grid-cols-2 md:grid-cols-3 gap-6">
          <div>
            <p className="text-sm text-muted-foreground mb-1">Company</p>
            <p className="font-medium">{companyData.companyName}</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground mb-1">Industry</p>
            <p className="font-medium">{companyData.industry}</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground mb-1">Employees</p>
            <p className="font-medium">{companyData.employees}</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground mb-1">Electricity</p>
            <p className="font-medium">{companyData.electricity} kWh</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground mb-1">Fuel</p>
            <p className="font-medium">{companyData.fuel} L</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground mb-1">Water</p>
            <p className="font-medium">{companyData.water} m³</p>
          </div>
        </div>

        <div className="mt-6 p-4 bg-blue-50 rounded-lg flex items-start gap-3 border border-blue-100">
          <AlertCircle className="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" />
          <p className="text-sm text-blue-800">
            Our AI engine will analyze these metrics against industry standards and BRSR frameworks to calculate your ESG score and compliance risk.
          </p>
        </div>
      </motion.div>

      <div className="flex justify-center">
        <Button 
          size="lg" 
          onClick={handleGenerate} 
          disabled={isGenerating}
          className="bg-[#2ecc71] hover:bg-[#27ae60] text-white min-w-[250px] h-14 text-lg shadow-lg hover:shadow-xl transition-all"
        >
          {isGenerating ? (
            <>
              <Loader2 className="w-5 h-5 mr-2 animate-spin" />
              Analyzing Data...
            </>
          ) : (
            'Generate Report'
          )}
        </Button>
      </div>
    </div>
  );
}

