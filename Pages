import React, { useState, useRef, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { Send, Bot, User, Sparkles, Trash2, Clock, ArrowRight, Database, FileText } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { matchQuestion } from '../lib/esgMatcher.js';

function AIESGAssistantPage() {
  const navigate = useNavigate();
  const [messages, setMessages] = useState([
    { 
      id: 1, 
      type: 'ai', 
      text: 'Hello! I am your intelligent ESG Assistant. I can help you understand ESG frameworks, calculate carbon footprints, or guide you through compliance requirements. What would you like to know?',
      timestamp: new Date().toISOString()
    }
  ]);
  const [inputValue, setInputValue] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const messagesEndRef = useRef(null);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  useEffect(() => {
    scrollToBottom();
  }, [messages, isTyping]);

  const formatTime = (isoString) => {
    const date = new Date(isoString);
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  };

  const handleClearChat = () => {
    setMessages([
      { 
        id: Date.now(), 
        type: 'ai', 
        text: 'Chat history cleared. How can I assist you with your ESG goals today?',
        timestamp: new Date().toISOString()
      }
    ]);
  };

  const handleSend = (e) => {
    e?.preventDefault();
    if (!inputValue.trim()) return;

    const userMsg = inputValue.trim();
    const newMessages = [...messages, { 
      id: Date.now(), 
      type: 'user', 
      text: userMsg,
      timestamp: new Date().toISOString()
    }];
    
    setMessages(newMessages);
    setInputValue('');
    setIsTyping(true);

    // Simulate AI processing time
    setTimeout(() => {
      const { match, suggestions } = matchQuestion(userMsg);
      
      let aiResponse = {};
      
      if (match) {
        aiResponse = {
          id: Date.now() + 1,
          type: 'ai',
          text: match.answer,
          actionableSteps: match.actionableSteps,
          relatedTopics: match.relatedTopics,
          timestamp: new Date().toISOString()
        };
      } else {
        aiResponse = {
          id: Date.now() + 1,
          type: 'ai',
          text: "I'm not entirely sure about that specific query. My expertise is focused on Environmental, Social, and Governance (ESG) topics, compliance frameworks like BRSR, and sustainability strategies.",
          fallbackSuggestions: suggestions,
          timestamp: new Date().toISOString()
        };
      }

      setMessages(prev => [...prev, aiResponse]);
      setIsTyping(false);
    }, 1200);
  };

  const handleSuggestionClick = (text) => {
    setInputValue(text);
  };

  return (
    <div className="max-w-5xl mx-auto h-[calc(100vh-6rem)] flex flex-col bg-card rounded-2xl shadow-sm border border-border overflow-hidden">
      {/* Header */}
      <div className="p-4 border-b border-border bg-muted/30 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-full bg-brand-blue flex items-center justify-center shadow-sm">
            <Bot className="w-5 h-5 text-white" />
          </div>
          <div>
            <h2 className="text-lg font-semibold text-foreground">ESG Intelligence Agent</h2>
            <p className="text-xs text-[#2ecc71] flex items-center gap-1 font-medium">
              <span className="w-2 h-2 rounded-full bg-[#2ecc71] animate-pulse"></span>
              Online & Ready
            </p>
          </div>
        </div>
        <Button 
          variant="ghost" 
          size="sm" 
          onClick={handleClearChat}
          className="text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors"
        >
          <Trash2 className="w-4 h-4 mr-2" />
          Clear Chat
        </Button>
      </div>

      {/* Chat Area */}
      <div className="flex-1 overflow-y-auto p-6 space-y-6 bg-background/50">
        <AnimatePresence initial={false}>
          {messages.map((msg) => (
            <motion.div
              key={msg.id}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              className={`flex gap-4 ${msg.type === 'user' ? 'flex-row-reverse' : ''}`}
            >
              <div className={`w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 shadow-sm ${
                msg.type === 'user' ? 'bg-brand-blue text-white' : 'bg-muted border border-border text-muted-foreground'
              }`}>
                {msg.type === 'user' ? <User className="w-4 h-4" /> : <Bot className="w-4 h-4" />}
              </div>
              
              <div className={`flex flex-col ${msg.type === 'user' ? 'items-end' : 'items-start'} max-w-[80%]`}>
                <div className={`rounded-2xl p-4 shadow-sm ${
                  msg.type === 'user' 
                    ? 'bg-brand-blue text-white rounded-tr-sm' 
                    : 'bg-card border border-border text-foreground rounded-tl-sm'
                }`}>
                  <p className="text-sm leading-relaxed whitespace-pre-wrap">{msg.text}</p>
                  
                  {/* Actionable Steps (if AI match) */}
                  {msg.actionableSteps && (
                    <div className="mt-4 pt-4 border-t border-border/50">
                      <p className="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">Recommended Actions:</p>
                      <ul className="space-y-2">
                        {msg.actionableSteps.map((step, idx) => (
                          <li key={idx} className="text-sm flex items-start gap-2">
                            <div className="w-1.5 h-1.5 rounded-full bg-[#2ecc71] mt-1.5 flex-shrink-0" />
                            <span className="text-muted-foreground">{step}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {/* Fallback Suggestions */}
                  {msg.fallbackSuggestions && (
                    <div className="mt-4 pt-4 border-t border-border/50">
                      <p className="text-sm text-muted-foreground mb-2">You might want to ask about:</p>
                      <div className="flex flex-wrap gap-2">
                        {msg.fallbackSuggestions.map((sugg, idx) => (
                          <button
                            key={idx}
                            onClick={() => handleSuggestionClick(`Tell me about ${sugg}`)}
                            className="text-xs px-3 py-1.5 rounded-full bg-muted hover:bg-brand-blue hover:text-white transition-colors border border-border"
                          >
                            {sugg}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
                
                <div className="flex items-center gap-1 mt-1 text-[10px] text-muted-foreground px-1">
                  <Clock className="w-3 h-3" />
                  {formatTime(msg.timestamp)}
                </div>
              </div>
            </motion.div>
          ))}
        </AnimatePresence>
        
        {isTyping && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            className="flex gap-4"
          >
            <div className="w-8 h-8 rounded-full bg-muted border border-border flex items-center justify-center flex-shrink-0">
              <Bot className="w-4 h-4 text-muted-foreground" />
            </div>
            <div className="bg-card border border-border rounded-2xl rounded-tl-sm p-4 flex items-center gap-1 shadow-sm">
              <span className="w-2 h-2 bg-brand-blue/50 rounded-full animate-bounce" style={{ animationDelay: '0ms' }}></span>
              <span className="w-2 h-2 bg-brand-blue/50 rounded-full animate-bounce" style={{ animationDelay: '150ms' }}></span>
              <span className="w-2 h-2 bg-brand-blue/50 rounded-full animate-bounce" style={{ animationDelay: '300ms' }}></span>
            </div>
          </motion.div>
        )}
        <div ref={messagesEndRef} />
      </div>

      {/* Next Steps / Quick Actions */}
      <div className="px-6 py-3 bg-muted/30 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
        <div className="flex items-center gap-2 text-sm text-muted-foreground">
          <Sparkles className="w-4 h-4 text-[#2ecc71]" />
          <span>Ready to take action?</span>
        </div>
        <div className="flex gap-2 w-full sm:w-auto">
          <Button 
            variant="outline" 
            size="sm" 
            onClick={() => navigate('/data-input')}
            className="flex-1 sm:flex-none bg-background hover:bg-brand-blue/5 hover:text-brand-blue border-border"
          >
            <Database className="w-4 h-4 mr-2" />
            Input Data
          </Button>
          <Button 
            size="sm" 
            onClick={() => navigate('/generate-report')}
            className="flex-1 sm:flex-none bg-brand-blue hover:bg-brand-blue/90 text-white"
          >
            <FileText className="w-4 h-4 mr-2" />
            Generate Report
          </Button>
        </div>
      </div>

      {/* Input Area */}
      <div className="p-4 bg-background border-t border-border">
        <form onSubmit={handleSend} className="flex gap-3 max-w-4xl mx-auto">
          <Input
            value={inputValue}
            onChange={(e) => setInputValue(e.target.value)}
            placeholder="Ask about ESG compliance, carbon reduction, or reporting frameworks..."
            className="flex-1 bg-muted/50 border-border focus-visible:ring-brand-blue h-12 rounded-xl"
          />
          <Button 
            type="submit" 
            disabled={!inputValue.trim() || isTyping} 
            className="bg-[#2ecc71] hover:bg-[#27ae60] text-white h-12 px-6 rounded-xl shadow-sm transition-all active:scale-[0.98]"
          >
            <Send className="w-5 h-5" />
          </Button>
        </form>
      </div>
    </div>
  );
}

export default AIESGAssistantPage;

