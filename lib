import { knowledgeBase } from './esgKnowledgeBase.js';

/**
 * Analyzes a user question and matches it to the most relevant ESG knowledge base topic.
 * @param {string} question - The user's input question.
 * @returns {Object} - An object containing the match, confidence score, and fallback suggestions.
 */
export function matchQuestion(question) {
  if (!question || typeof question !== 'string') {
    return { match: null, confidence: 0, suggestions: [] };
  }

  const normalizedQuestion = question.toLowerCase().trim();
  let bestMatch = null;
  let highestScore = 0;

  // Simple tokenization for word matching
  const questionWords = normalizedQuestion.split(/[\s,.-?]+/).filter(w => w.length > 2);

  for (const entry of knowledgeBase) {
    let score = 0;

    for (const keyword of entry.keywords) {
      const normalizedKeyword = keyword.toLowerCase();
      
      // Exact phrase match gets highest weight
      if (normalizedQuestion.includes(normalizedKeyword)) {
        score += 10 + (normalizedKeyword.split(' ').length * 5);
      } else {
        // Partial word match
        const keywordWords = normalizedKeyword.split(' ');
        let matchedWords = 0;
        
        for (const kw of keywordWords) {
          if (questionWords.includes(kw)) {
            matchedWords++;
          }
        }
        
        if (matchedWords > 0) {
          score += (matchedWords / keywordWords.length) * 5;
        }
      }
    }

    if (score > highestScore) {
      highestScore = score;
      bestMatch = entry;
    }
  }

  // Generate fallback suggestions if confidence is low
  const suggestions = knowledgeBase
    .map(entry => entry.topic)
    .sort(() => 0.5 - Math.random())
    .slice(0, 3);

  // Threshold for a "good" match
  if (highestScore >= 5) {
    return { 
      match: bestMatch, 
      confidence: highestScore,
      suggestions: []
    };
  }

  return { 
    match: null, 
    confidence: highestScore,
    suggestions 
  };
}

