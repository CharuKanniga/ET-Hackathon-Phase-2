import React from 'react';
import { TrendingUp, AlertTriangle, CheckCircle } from 'lucide-react';

function ComplianceReportDisplay({ esgScore, carbonEmission, complianceRisk, suggestions }) {
  const getRiskColor = (risk) => {
    if (risk === 'Low') return 'text-green-600 bg-green-50 border-green-200';
    if (risk === 'Medium') return 'text-yellow-600 bg-yellow-50 border-yellow-200';
    return 'text-red-600 bg-red-50 border-red-200';
  };

  const getRiskIcon = (risk) => {
    if (risk === 'Low') return CheckCircle;
    if (risk === 'Medium') return AlertTriangle;
    return AlertTriangle;
  };

  const RiskIcon = getRiskIcon(complianceRisk);

  return (
    <div className="mt-8 space-y-6">
      <div className="bg-gradient-to-br from-[#2ecc71]/10 to-[#27ae60]/5 rounded-2xl p-8 border-2 border-[#2ecc71]/20">
        <h3 className="text-2xl font-bold text-[#1a3a52] mb-6">Compliance Report Generated</h3>
        
        {/* ESG Score */}
        <div className="mb-6">
          <div className="flex items-center gap-3 mb-2">
            <TrendingUp className="w-6 h-6 text-[#2ecc71]" />
            <h4 className="text-lg font-semibold text-[#1a3a52]">ESG Score</h4>
          </div>
          <p className="text-5xl font-bold text-[#2ecc71]">{esgScore}/100</p>
        </div>

        {/* Carbon Emission */}
        <div className="mb-6">
          <h4 className="text-lg font-semibold text-[#1a3a52] mb-2">Carbon Emission</h4>
          <p className="text-2xl font-bold text-gray-700">{carbonEmission.toFixed(2)} kg CO₂</p>
        </div>

        {/* Compliance Risk */}
        <div className="mb-6">
          <h4 className="text-lg font-semibold text-[#1a3a52] mb-3">Compliance Risk Level</h4>
          <div className={`inline-flex items-center gap-2 px-4 py-2 rounded-lg border-2 font-semibold ${getRiskColor(complianceRisk)}`}>
            <RiskIcon className="w-5 h-5" />
            {complianceRisk}
          </div>
        </div>

        {/* Sustainability Suggestions */}
        {suggestions.length > 0 && (
          <div>
            <h4 className="text-lg font-semibold text-[#1a3a52] mb-3">Sustainability Recommendations</h4>
            <ul className="space-y-2">
              {suggestions.map((suggestion, index) => (
                <li key={index} className="flex items-start gap-3">
                  <CheckCircle className="w-5 h-5 text-[#2ecc71] flex-shrink-0 mt-0.5" />
                  <span className="text-gray-700">{suggestion}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  );
}

export default ComplianceReportDisplay;

